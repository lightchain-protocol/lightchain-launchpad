# Copy to `.env` in the repo root before `docker compose up --build` (production-ish stack).
# For local Anvil development, prefer `make start` / `docker-compose.dev.yml` —
# app env files are written by `scripts/dev/sync-env.sh`.

# Chain / indexer
DATABASE_SCHEMA=public
RPC_URL=http://host.docker.internal:8545
CHAIN_ID=1337
LAUNCHPAD_ADDRESS=0x0000000000000000000000000000000000000000
START_BLOCK=0
FINALITY_BLOCK_COUNT=0

# API
PUBLIC_URL=http://localhost:3001
CORS_ORIGIN=*
TRUST_PROXY=false
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud

# Frontend (baked into the web image at build time — use host-reachable URLs)
NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_WEBSCOKET_URL=http://localhost:3001
