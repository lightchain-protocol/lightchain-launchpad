# Postgres — the SAME instance the Ponder indexer writes to. The API only reads
# Ponder's tables (workspace-imported schema from @lcai/indexer/schema). The
# `token_metadata` table is owned by Ponder; the API resolver writes to it via
# its own drizzle handle.
DATABASE_URL="postgresql://lcai:lcai@localhost:5433/lcai_launchpad"

# HTTP
PORT="3001"
HOST="0.0.0.0"
PUBLIC_URL="http://localhost:3001"
CORS_ORIGIN="*"
LOG_LEVEL="info"
NODE_ENV="development"

# Chain RPC — used by /v1/status to read the head block.
RPC_URL="http://127.0.0.1:8545"

# Launchpad proxy address. The API uses it to exclude the launchpad's holdings
# (the unsold for-sale supply each token mints to it) from "top holders" queries.
# If unset, falls back to LAUNCHPAD_ADDRESS (the indexer's env var).
LAUNCHPAD_ADDRESS="0x0000000000000000000000000000000000000000"

# Pinata (IPFS pinning for the POST /v1/metadata upload endpoint).
PINATA_JWT=""
PINATA_GATEWAY="gateway.pinata.cloud"

# Comma-separated IPFS gateways the metadata resolver tries, in order (ours first).
IPFS_GATEWAYS="https://gateway.pinata.cloud/ipfs/,https://ipfs.io/ipfs/,https://cloudflare-ipfs.com/ipfs/"

# Upload limits
MAX_IMAGE_BYTES="4194304"
RATE_LIMIT_GLOBAL_PER_MIN="300"
RATE_LIMIT_UPLOAD_PER_MIN="10"
