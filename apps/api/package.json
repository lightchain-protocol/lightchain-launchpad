{
  "name": "@lcai/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "predev": "pnpm --filter @lcai/abis build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint --max-warnings 5"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@fastify/swagger": "^9.2.0",
    "@fastify/swagger-ui": "^5.1.0",
    "@lcai/abis": "workspace:*",
    "@lcai/indexer": "workspace:*",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "fastify": "^5.2.0",
    "pino": "^9.5.0",
    "pinata": "^2.2.2",
    "postgres": "^3.4.5",
    "socket.io": "^4.8.1",
    "viem": "^2.52.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@lcai/eslint-config": "workspace:*",
    "@types/node": "^22.10.0",
    "eslint": "^9",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}