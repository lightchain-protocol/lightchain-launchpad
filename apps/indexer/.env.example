# IMPORTANT: Ponder reads `.env.local` and NOTHING ELSE — literally
# `dotenv.config({ path: ".env.local" })`. Copying this file to `.env` alone
# leaves the indexer with no config at all ("no connection string was
# provided"). `scripts/dev/sync-env.sh` writes both files for that reason; in
# production, make `.env.local` the real file (or a symlink to `.env`).

# Postgres (same instance the API reads). Ponder owns its tables; it exposes
# stable read views in the `public` schema that the API queries.
#
# Changing this string later makes Ponder consider it a DIFFERENT app — the
# config it hashes for identity embeds the connection string, so even
# 127.0.0.1 -> localhost triggers "Schema 'public' was previously used by a
# different Ponder app" and the schema has to be dropped.
DATABASE_URL="postgresql://lcai:lcai@127.0.0.1:5432/lcai_launchpad"

# Required for `ponder start` (production). `ponder dev` defaults to public.
# NOTE: Ponder resolves the schema BEFORE dotenv loads .env.local, so setting it
# here only works when it is a real process env var (as in apps/indexer/
# Dockerfile). Under pm2/systemd pass `--schema public` on the CLI instead —
# see ecosystem.config.cjs.
DATABASE_SCHEMA="public"

# Chain
RPC_URL="http://127.0.0.1:8545"
CHAIN_ID="1337"

# Deployed Launchpad (UUPS proxy) address and the block it was deployed at.
# `npx hardhat run scripts/deploy.ts --network localhost` prints both.
# (Kept as LAUNCHPAD_ADDRESS for backward compat — single contract now.)
LAUNCHPAD_ADDRESS="0x0000000000000000000000000000000000000000"
START_BLOCK="0"

# How many blocks behind the head to treat as final (reorg safety). For a local
# node 0 is fine; on a real chain set this to the chain's finality depth.
FINALITY_BLOCK_COUNT="0"

# Ponder's built-in API server (graphql/sql/ready) — keep bound to localhost; the
# public API is served by the @lcai/api service, not Ponder.
PONDER_PORT="42069"

# How often the indexer NOTIFYs `lcai:status` with the current indexer-vs-RPC
# head; the API fans this to SSE subscribers on `/v1/stream/status`.
STATUS_BROADCAST_MS="5000"
