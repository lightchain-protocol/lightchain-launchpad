NEXT_PUBLIC_API_URL="http://localhost:3001/v1"
NEXT_PUBLIC_WEBSCOKET_URL="http://localhost:3001"

# Ethereum mainnet RPC, used only to read LCAI/USD (Uniswap V3 LCAI/WETH pool +
# Chainlink ETH/USD — see config.priceFeed). Optional: unset, useNativePrice
# falls back to two public endpoints. Set it for anything user-facing — when
# the read fails every "$" figure on the site renders "—" rather than a number.
# NEXT_PUBLIC_MAINNET_RPC_URL="https://mainnet.infura.io/v3/…"

# Set by `make deploy` / scripts/dev/sync-env.sh for Anvil (chainId 1337).
# NEXT_PUBLIC_ENABLE_LOCALHOST="true"
# NEXT_PUBLIC_LAUNCHPAD_ADDRESS="0x…"
# NEXT_PUBLIC_UNISWAP_V2_ROUTER="0x…"
# NEXT_PUBLIC_WETH_ADDRESS="0x…"
