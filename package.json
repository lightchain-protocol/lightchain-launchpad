{
  "name": "lcai-launchpad",
  "private": true,
  "version": "0.1.0",
  "description": "LCAI meme-token launchpad monorepo — Solidity contracts, Ponder indexer, Fastify API, Next.js frontend",
  "license": "MIT",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "gen:abis": "pnpm --filter @lcai/abis gen",
    "compile:contracts": "cd contracts && npx hardhat compile",
    "test:contracts": "cd contracts && npx hardhat test --network hardhat",
    "dev:indexer": "pnpm --filter @lcai/indexer dev",
    "dev:api": "pnpm --filter @lcai/api dev",
    "dev:frontend": "pnpm --filter @lcai/frontend dev",
    "build:frontend": "pnpm --filter @lcai/frontend build",
    "test": "pnpm -r test",
    "db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
    "db:down": "docker compose -f docker-compose.dev.yml down",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "dev:local": "make start",
    "dev:infra": "make infra",
    "dev:deploy": "make deploy"
  },
  "devDependencies": {
    "@lcai/eslint-config": "workspace:*",
    "@lcai/typescript-config": "workspace:*",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "turbo": "^2.9.15",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.4"
}
